# ==========================================
# RouteX Environment Configuration Example
# ==========================================

# Backend Settings
ROUTEX_SECRET_KEY=routex-production-super-secret-key-replace-this-randomly
ROUTEX_ALGORITHM=HS256
ROUTEX_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default is local SQLite; set PostgreSQL URI for production)
ROUTEX_DATABASE_URL=sqlite:///./routex.db
# ROUTEX_DATABASE_URL=postgresql://routex_user:password@localhost:5432/routex_db

# Operations Timing Limits
ROUTEX_DEFAULT_PRIORITY_TIMEOUT_SECONDS=20
ROUTEX_REQUEST_EXPIRY_SECONDS=60
ROUTEX_HEARTBEAT_TIMEOUT_SECONDS=45

# Device Security
ROUTEX_REQUIRE_VERIFIED_DEVICE_AUTH=true
ROUTEX_SIMULATED_MODE_ALLOWED=true

# Frontend Dashboard
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# Mobile Flutter App
# In mobile/lib/services/api_service.dart or configure in App Settings screen:
# Android Emulator: http://10.0.2.2:8000/api
# Physical Device on local Wi-Fi: http://192.168.1.100:8000/api

# RouteX Operations Dashboard Environment Configuration
# If VITE_API_BASE_URL is left unset or blank, the frontend dynamically uses
# http://<current-browser-hostname>:8000/api so local PC and LAN mobile devices connect seamlessly.
VITE_API_BASE_URL=

# Google Maps Platform JavaScript API Key (Optional)
# Obtain from https://console.cloud.google.com/google/maps-apis/credentials
# Restrict key to your HTTP referrers (e.g. http://localhost:5173/*, http://127.0.0.1:5173/*)
# If left empty, RouteX renders a high-precision SVG/Graph corridor visualizer with zero external dependencies.
VITE_GOOGLE_MAPS_API_KEY=

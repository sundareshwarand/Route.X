# ==========================================
# RouteX Production Environment Configuration
# ==========================================

# --- BACKEND (Render / Cloud Environment) ---
ROUTEX_ENVIRONMENT=production
ROUTEX_HOST=0.0.0.0
ROUTEX_PORT=8000
ROUTEX_SECRET_KEY=generate-a-strong-random-32-byte-secret-key-here
ROUTEX_DATABASE_URL=sqlite:///./routex.db

# CORS Allowed Origins (Comma-separated list or * for initial testing)
# In production, set to your specific frontend URL, e.g. https://routex-dashboard.pages.dev
ROUTEX_CORS_ORIGINS=https://*,http://localhost:5173

# Google Gemini Advisory Integration
ROUTEX_GEMINI_API_KEY=AIzaSy...your-gemini-key
ROUTEX_GEMINI_MODEL=gemini-2.5-flash

# --- FRONTEND (Cloudflare Pages / Vercel) ---
# Replace with your deployed backend URL (no trailing slash)
VITE_API_BASE_URL=https://routex-backend.onrender.com/api
# Optional: VITE_WS_URL is automatically derived if omitted
# VITE_WS_URL=wss://routex-backend.onrender.com/ws
